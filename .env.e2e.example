# Copy this file to .env.e2e.local. The local file is ignored by Git.
# Use two dedicated users in an independent test tenant.

TEAMS_CLI_E2E_TENANT_ID=

TEAMS_CLI_E2E_ALICE_USERNAME=
TEAMS_CLI_E2E_ALICE_PASSWORD=

TEAMS_CLI_E2E_BOB_USERNAME=
TEAMS_CLI_E2E_BOB_PASSWORD=

# edge or chrome
TEAMS_CLI_E2E_BROWSER=edge

# Set false for visible local troubleshooting. CI should normally use true.
TEAMS_CLI_E2E_HEADLESS=true
